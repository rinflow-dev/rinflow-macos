          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のデバイスから認識できないデータが届いたため、接続を切断しました。両方の Rinflow を最新版にアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
