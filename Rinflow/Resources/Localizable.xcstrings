            "state" : "translated",
            "value" : "A switch or lock shortcut is used by another app. Change the combination or close the conflicting app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替えまたはロックのショートカットがほかのアプリで使われています。組み合わせを変更するか、競合しているアプリを終了してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换或锁定快捷键已被其他程序占用。请修改组合键或关闭冲突程序。"
          }
        }
      }
    },
