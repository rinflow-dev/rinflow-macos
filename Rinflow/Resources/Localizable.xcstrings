          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のデバイスが接続を拒否しました。このMacが削除されたか、ペアリング済みのデバイスのみ許可されている可能性があります。「接続」をクリックすると再度ペアリングできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方拒绝了连接：对方可能移除了本机，或只允许已配对的设备。点“连接”可以重新配对。"
          }
