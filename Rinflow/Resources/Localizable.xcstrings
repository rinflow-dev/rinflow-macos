    "光标只显示在指针所在的设备上；动一下这台 Mac 的鼠标或触控板就会出现。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cursor shows only on the device the pointer is on. Move this Mac’s mouse or trackpad to bring it back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルはポインタがあるデバイスにだけ表示されます。このMacのマウスやトラックパッドを動かすと再び表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标只显示在指针所在的设备上；动一下这台 Mac 的鼠标或触控板就会出现。"
          }
        }
      }
    },
    "全屏时暂停自动切换" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause edge switching in full screen"
