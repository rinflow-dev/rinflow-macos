    "在另一台设备上工作时，这台 Mac 不会因闲置而熄屏或锁定。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While you work on another device, this Mac doesn’t turn off its display or lock for being idle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスで作業している間、このMacはアイドル状態でもディスプレイをオフにしたりロックしたりしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一台设备上工作时，这台 Mac 不会因闲置而熄屏或锁定。"
          }
        }
      }
    },
    "在系统设置中允许登录启动" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow login launch in System Settings"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
