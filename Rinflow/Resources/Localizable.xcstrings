{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%@ 想发送 %lld 个文件" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ wants to send a file"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ wants to send %2$lld files"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が%2$lld個のファイルを送ろうとしています"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 想发送 %2$lld 个文件"
          }
        }
      }
    },
    "%@ 等 %lld 项，已保存到“下载/Rinflow”" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and more (%2$lld items), saved to Downloads/Rinflow"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ほか%2$lld項目を「ダウンロード/Rinflow」に保存しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 等 %2$lld 项，已保存到“下载/Rinflow”"
          }
        }
      }
    },
    "%@：%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@"
          }
        }
      }
    },
    "Ctrl+C、Ctrl+V 等按 ⌘ 快捷键执行，Windows 键对应 ⌃。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+C, Ctrl+V and the like work as ⌘ shortcuts, and the Windows key is ⌃."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+C、Ctrl+V などは ⌘ のショートカットとして動作し、Windows キーは ⌃ になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+C、Ctrl+V 等按 ⌘ 快捷键执行，Windows 键对应 ⌃。"
          }
        }
      }
    },
    "IP 地址或设备名称" : {
