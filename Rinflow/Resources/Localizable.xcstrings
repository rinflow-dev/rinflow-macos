{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%@ 想发送 %lld 个文件" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ wants to send a file"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ wants to send %2$lld files"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が%2$lld個のファイルを送ろうとしています"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 想发送 %2$lld 个文件"
          }
        }
      }
    },
    "%@ 等 %lld 项，已保存到“下载/Rinflow”" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and more (%2$lld items), saved to Downloads/Rinflow"
