    },
    "其他设备的指针离开后隐藏光标" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide the cursor when another device’s pointer leaves"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスのポインタが離れたらカーソルを隠す"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他设备的指针离开后隐藏光标"
          }
        }
      }
    },
    "切换或锁定快捷键已被其他程序占用。请修改组合键或关闭冲突程序。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A switch or lock shortcut is used by another app. Change the combination or close the conflicting app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替えまたはロックのショートカットがほかのアプリで使われています。組み合わせを変更するか、競合しているアプリを終了してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换或锁定快捷键已被其他程序占用。请修改组合键或关闭冲突程序。"
          }
        }
      }
    },
    "切换设备时同步复制的文字、图片和文件。仅在信任对方设备时开启。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share copied text, images and files when switching devices. Enable only for devices you trust."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスを切り替えるときに、コピーしたテキスト、画像、ファイルを同期します。信頼できるデバイスの場合のみオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换设备时同步复制的文字、图片和文件。仅在信任对方设备时开启。"
          }
        }
      }
    },
